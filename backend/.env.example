# ─── EntitlementLedger Environment Variables ──────────────────────────────
#
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.
# NEVER expose secret values to the frontend or API responses.

# ─── Application ──────────────────────────────────────────────────────────
# Environment: development | test | production
ENV=development

# Seed data only loads in development/test mode
SEED_DATA=true

# ─── Database ─────────────────────────────────────────────────────────────
# Option 1: SQLite (development default, no setup needed)
# EL_DB_PATH=./entitlement_ledger.db

# Option 2: PostgreSQL (production recommended)
# DATABASE_URL=postgresql://user:password@localhost:5432/entitlement_ledger

# ─── JWT / Authentication ─────────────────────────────────────────────────
# REQUIRED in production. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=

# Token expiry in minutes (default: 480 = 8 hours)
JWT_EXPIRE_MINUTES=480

# ─── CORS ─────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
# Production: https://your-domain.com
# Development: http://localhost:5173,http://localhost:3000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ─── Razorpay Integration ────────────────────────────────────────────────
# Create test-mode keys at: https://dashboard.razorpay.com → Settings → API Keys
#
# SECURITY: These must NEVER be exposed to the frontend or API responses.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
#
# Webhook secret (different from API key secret!)
# Create at: https://dashboard.razorpay.com → Settings → Webhooks
# This is used to verify X-Razorpay-Signature on incoming webhooks.
RAZORPAY_WEBHOOK_SECRET=

# ─── AI Provider (optional) ──────────────────────────────────────────────
# The system auto-selects the best available provider in this order:
#   Development: 1. Ollama (local)  2. Groq  3. Gemini  4. OpenRouter  5. Anthropic
#   Production : PRODUCTION_PROVIDER=groq (default) | gemini — Ollama is
#                intentionally NOT allowed in production (localhost-only).
#
# The reconciliation AI investigator is demand-driven: AI runs only when the
# deterministic gate finds genuine ambiguity, and AI can never change
# financial amounts or approve cases.  All providers are optional — if none
# is configured the product still reconciles deterministically.
#
# 1) Ollama (local, free, no API key) — development only:
#    Install: https://ollama.ai   ·  ollama pull qwen3.5   ·  ollama serve
OLLAMA_MODEL=qwen3.5:latest
OLLAMA_BASE_URL=http://localhost:11434

# 2) Groq — recommended cloud provider (native tool calling, strict JSON):
#    Get a key: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# 3) Gemini (cloud):
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# 4) OpenRouter (cloud, OpenAI-compatible):
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-31b-it:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# 5) Anthropic Claude (optional — requires the anthropic SDK, which is NOT a
#    bundled dependency; Groq/Gemini/OpenRouter/Ollama are the supported paths):
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Production provider override (default groq):
PRODUCTION_PROVIDER=groq

# ─── Logging ──────────────────────────────────────────────────────────────
# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
