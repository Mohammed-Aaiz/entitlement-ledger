# ─── EntitlementLedger Environment Variables ──────────────────────────────
#
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.
# NEVER expose secret values to the frontend or API responses.

# ─── Application ──────────────────────────────────────────────────────────
# Environment: development | test | production
ENV=development

# Seed data only loads in development/test mode
SEED_DATA=true

# ─── Database ─────────────────────────────────────────────────────────────
# Option 1: SQLite (development default, no setup needed)
# EL_DB_PATH=./entitlement_ledger.db

# Option 2: PostgreSQL (production recommended)
# DATABASE_URL=postgresql://user:password@localhost:5432/entitlement_ledger

# ─── JWT / Authentication ─────────────────────────────────────────────────
# REQUIRED in production. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=

# Token expiry in minutes (default: 480 = 8 hours)
JWT_EXPIRE_MINUTES=480

# ─── CORS ─────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
# Production: https://your-domain.com
# Development: http://localhost:5173,http://localhost:3000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ─── Razorpay Integration ────────────────────────────────────────────────
# Create test-mode keys at: https://dashboard.razorpay.com → Settings → API Keys
#
# SECURITY: These must NEVER be exposed to the frontend or API responses.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
#
# Webhook secret (different from API key secret!)
# Create at: https://dashboard.razorpay.com → Settings → Webhooks
# This is used to verify X-Razorpay-Signature on incoming webhooks.
RAZORPAY_WEBHOOK_SECRET=

# ─── AI Provider ─────────────────────────────────────────────────────────
# The system auto-selects the best available provider:
#   1. Ollama (local, free, no API key) — for development
#   2. OpenRouter (cloud, requires OPENROUTER_API_KEY) — for production
#   3. Anthropic Claude (requires ANTHROPIC_API_KEY)
#
# To use Ollama (local development):
#   1. Install: https://ollama.ai
#   2. Pull a model: ollama pull qwen3.5
#   3. Start server: ollama serve
#
OLLAMA_MODEL=qwen3.5:latest
OLLAMA_BASE_URL=http://localhost:11434

# To use OpenRouter (production — recommended):
#   Sign up at: https://openrouter.ai
#   Get API key from: https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# To use Anthropic Claude:
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# ─── Logging ──────────────────────────────────────────────────────────────
# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
